    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- API と同じ user-secrets(接続文字列)を読む -->
    <UserSecretsId>37da7993-00e4-48d2-9170-0137b917f1d6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
