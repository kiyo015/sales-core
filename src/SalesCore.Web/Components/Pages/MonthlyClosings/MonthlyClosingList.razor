@page "/monthly-closings"
@rendermode PageRenderMode.Interactive
@inherits OperationPage
@inject MonthlyClosingUseCases Months
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

@* 月次締めと、締めた月の一覧。一覧は全員が見られる。締めの欄は月次締めができる役割(経理・管理者)にだけ出す(業務ルール集「役割」)。
   締めるのは「次に締める月」だけ(前の月から順にしか締められない)。終わっていない月はボタンを押せない。
   一覧は締めた月だけ(2026-11-27 本人の決定)。締めると、その月の請求先ごとの残高の画面に移る *@

<PageTitle>売掛金の残高</PageTitle>

<h1>売掛金の残高</h1>

<ErrorMessage Error="Error" />

@if (canClose && loaded)
{
    <section class="close">
        <h2>月次締め</h2>
        @if (next is null)
        {
            <p>締める取引（売上・入金）がありません。</p>
        }
        else
        {
            <p>次に締める月: <span class="next-month">@MonthText(next.Year, next.Month)</span></p>
            @if (!next.HasEnded)
            {
                <p class="not-ended">月末を過ぎてから締められます。</p>
            }
            <button type="button" class="close-month" disabled="@(!next.HasEnded || closing)" @onclick="CloseAsync">締める</button>
        }
    </section>
}

@* 読み込んでから表を出す(読み込みの途中で表が出ると、まだ空なのか締めた月が無いのか分からない) *@
@if (closings is not null)
{
    <table class="monthly-closings">
        <thead>
            <tr><th>締めた月</th><th>期末の合計（円）</th></tr>
        </thead>
        <tbody>
            @foreach (var month in closings)
            {
                <tr>
                    <td><a href="monthly-closings/@month.Year/@month.Month">@MonthText(month.Year, month.Month)</a></td>
                    <td class="amount">@month.Closing.ToString("#,0")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<MonthlyClosingSummary>? closings;
    private NextClosingView? next;
    private bool canClose;
    private bool loaded;
    private bool closing;

    protected override Task OnInitializedAsync() => RunAsync(async () =>
    {
        canClose = Permissions.Allows(CurrentUser, Operation.CloseMonth);
        if (canClose) next = await Months.NextAsync(); // 次に締める月は、締める人の問い合わせ(営業は呼ばない)
        closings = await Months.ListAsync();
        loaded = true;
    });

    private async Task CloseAsync()
    {
        // 二度押しで同じ月を2回送らない(2回目は「締め済み」で止まるが、理由が紛らわしい)。描き直す前に2回目が届いても、ここで止める
        if (next is null || closing) return;
        closing = true;
        MonthlyClosingView? closed = null;
        await RunAsync(async () => closed = await Months.CloseAsync(next.Year, next.Month));
        closing = false;
        if (closed is not null) Navigation.NavigateTo($"monthly-closings/{closed.Year}/{closed.Month}");
    }

    internal static string MonthText(int year, int month) => $"{year}年{month}月";
}
