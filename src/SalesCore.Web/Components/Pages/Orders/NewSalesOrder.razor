@page "/orders/new"
@rendermode PageRenderMode.Interactive
@inherits OperationPage
@inject SalesOrderUseCases Orders
@inject MasterUseCases Masters
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation
@inject TimeProvider Clock

@* 受注の登録。登録できるのは営業と管理者(業務ルール集「役割」)。URL を直接開いた時も、入口と同じ表で拒む。
   単価の入れ方は見積の登録と共通(LinePricing。商品・得意先・受注日で入れ直し、手で直した単価を入れ直したら知らせる)。
   単価の欄を空にしたままでは送らない(見て確かめた単価で受注する。PR #15 の AIレビュー) *@

<PageTitle>受注の登録</PageTitle>

<h1>受注の登録</h1>

<ErrorMessage Error="Error" />
@if (repriced)
{
    <p role="status" class="repriced">単価を入れ直しました。確かめてから、もう一度登録してください。</p>
}
@if (Pricing.HandPriceReplaced)
{
    <p role="status" class="hand-repriced">手で直した単価を、得意先・日付に合わせて入れ直しました。確かめてください。</p>
}

@if (Permissions.Allows(CurrentUser, Operation.RegisterSalesOrder))
{
    <EditForm Model="form" OnSubmit="RegisterAsync" FormName="register-sales-order">
        <fieldset>
            <legend>受注</legend>
            <label>
                得意先
                <InputSelect id="customer" @bind-Value="form.CustomerCode" @bind-Value:after="Pricing.RepriceAllAsync">
                    <option value="">（選ぶ）</option>
                    @foreach (var customer in customers)
                    {
                        <option value="@customer.Code">@customer.Code @customer.Name</option>
                    }
                </InputSelect>
            </label>
            <label>受注日 <InputDate id="ordered-on" @bind-Value="form.OrderedOn" @bind-Value:after="Pricing.RepriceAllAsync" /></label>
        </fieldset>
        <table>
            <thead>
                <tr><th>商品</th><th>数量</th><th>単価（円）</th><th></th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Pricing.Lines.Count; i++)
                {
                    var index = i;
                    var line = Pricing.Lines[index];
                    <tr>
                        <td>
                            <InputSelect id="@($"product-{index}")" @bind-Value="line.ProductCode" @bind-Value:after="() => Pricing.PriceAsync(line)">
                                <option value="">（選ぶ）</option>
                                @foreach (var product in products)
                                {
                                    <option value="@product.Code">@product.Code @product.Name（@product.Unit）</option>
                                }
                            </InputSelect>
                        </td>
                        <td><InputNumber id="@($"quantity-{index}")" @bind-Value="line.Quantity" ParsingErrorMessage="数量は数で入力してください。" /></td>
                        <td><InputNumber id="@($"unit-price-{index}")" @bind-Value="line.UnitPrice" ParsingErrorMessage="単価は数で入力してください。" /></td>
                        <td>
                            @if (Pricing.Lines.Count > 1)
                            {
                                <button type="button" class="remove-line" @onclick="() => Pricing.Lines.Remove(line)">明細を消す</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button type="button" class="add-line" @onclick="() => Pricing.Lines.Add(new())">明細を足す</button>
        @* 数でない入力と空の単価は送らずに止める(数量・単価の決まりは Domain が確かめる) *@
        <ValidationSummary />
        <button type="submit">登録</button>
    </EditForm>
}

@code {
    private IReadOnlyList<CustomerView> customers = [];
    private IReadOnlyList<ProductView> products = [];
    private Input form = new();
    private FormCheck? check;
    private LinePricing? pricing;
    private bool repriced;

    // 得意先を選んでいなければ、標準単価(得意先別単価は得意先で決まる)
    private LinePricing Pricing => pricing ??= new(
        () => (form.CustomerCode, form.OrderedOn),
        async (customer, product, on) =>
            await Orders.UnitPriceForAsync(customer, product, on) ?? products.FirstOrDefault(p => p.Code == product)?.StandardPrice,
        RunAsync);

    protected override Task OnInitializedAsync() => RunAsync(async () =>
    {
        Permissions.Require(CurrentUser, Operation.RegisterSalesOrder);
        form.OrderedOn = Clock.Today(); // 日本時間の今日(サーバーのタイムゾーンに頼らない)
        // 無効にしたマスタでは受注できない(ユースケースも拒む)ので、選択肢に出さない
        customers = (await Masters.ListCustomersAsync()).Where(c => c.IsActive).ToList();
        products = (await Masters.ListProductsAsync()).Where(p => p.IsActive).ToList();
    });

    private async Task RegisterAsync(EditContext context)
    {
        // 押した時に見えていた単価で送る。待つ間に入れ直されたら、送らずに見せる
        repriced = false;
        if (!await Pricing.SettleAsync())
        {
            repriced = true;
            return;
        }
        // 明細はリストなので、注釈([Required])での検証は届かない。空の単価はここで止める
        check ??= new FormCheck(context, messages =>
        {
            foreach (var line in Pricing.Lines.Where(l => l.UnitPrice is null))
            {
                messages.Add(new FieldIdentifier(line, nameof(PricedLine.UnitPrice)), "単価を入力してください。");
            }
        });
        if (!check.Run()) return; // 数量・単価が数でない、単価が空
        SalesOrderView? order = null;
        // 選ばなかった得意先・商品は空、数量は0で送り、ユースケースの理由をそのまま出す。
        // 単価は画面に出した値を指定して送る(開いている間に標準単価が変わっても、利用者が見て確かめた単価で受注する)
        await RunAsync(async () => order = await Orders.CreateAsync(new CreateSalesOrder(
            form.CustomerCode ?? "",
            form.OrderedOn,
            Pricing.Lines.Select(l => new CreateSalesOrderLine(l.ProductCode ?? "", l.Quantity ?? 0m, l.UnitPrice!.Value)).ToList())));
        if (order is not null) Navigation.NavigateTo($"orders/{order.Id}");
    }

    private sealed class Input
    {
        public string? CustomerCode { get; set; }
        public DateOnly OrderedOn { get; set; }
    }
}
