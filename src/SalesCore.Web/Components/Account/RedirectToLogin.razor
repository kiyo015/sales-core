@inject NavigationManager Navigation

@* 対話的な画面遷移で、ログインしていない利用者がログインの要る画面に来た時に、ログインの画面へ送る。
   戻り先は今の画面(サイトの中の相対の道筋)。ログインの画面は Cookie を出すので、静的に描画し直させる(forceLoad) *@

@code {
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"account/login?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
