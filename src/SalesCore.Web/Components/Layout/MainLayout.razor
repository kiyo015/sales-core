@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <header>
            @* 表示名(クレーム)。無ければ利用者名 *@
            <span>@(context.User.FindFirst(SalesCoreClaims.DisplayName)?.Value ?? context.User.Identity?.Name)</span>
            @* ログアウトはフォームの送信だけで受け付ける(偽のリクエストを防ぐ印を付ける) *@
            <form action="account/logout" method="post">
                <AntiforgeryToken />
                <button type="submit">ログアウト</button>
            </form>
            <NavMenu />
        </header>
    </Authorized>
</AuthorizeView>

@Body

<div id="blazor-error-ui">
    問題が起きました。
    <a href="" class="reload">読み直す</a>
    <a class="dismiss">×</a>
</div>
